{
  "name": "history",
  "version": "2.0.0",
  "private": true,
  "description": "History — Vietnamese history slide deck (Electron)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron . --force_high_performance_gpu --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows --js-flags=--max-old-space-size=4096",
    "fonts": "python3 tools/fetch-fonts.py",
    "export": "electron tools/export-pdf.js --disable-renderer-backgrounding --disable-background-timer-throttling",
    "record": "electron tools/record-video.js --disable-renderer-backgrounding --disable-background-timer-throttling",
    "web": "python3 -m http.server 8766 --bind 127.0.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "ffmpeg-static": "^5.3.0"
  }
}
